# Copy this file to .env and fill in your keys.

# --- Voice (ElevenLabs) ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Optional: your own designed voice id (ElevenLabs Voice Design). Default is the premade "Rachel".
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Language model (Gemini) ---
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-3.8-flash

# --- ESP32 / VitaWatch hardware link (firmware unchanged) ---
# Reading live data needs nothing: it uses the endpoint the firmware already posts to.
# DEVICE_BACKEND_URL=https://jeevan-backend-nine.vercel.app
# DEVICE_ID=esp32_jeevancare_01
# Needed ONLY to switch which sensor streams (auto-rotate pulse/SpO2 <-> temperature) from this page:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend origins allowed to call this server
# VOICE_AGENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
